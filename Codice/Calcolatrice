public class Calculator {
    
    private Calculator() {}
    
    // Operazioni basilari
    static double sum(double x, double y) {
        return x + y;
    }
    
    static double subtract(double x, double y) {
        return x - y;
    }
    
    static double product(double x, double y) {
        return x * y;
    }
    
    static double divide(double x, double y) {
        if (y == 0) {
            throw new IllegalArgumentException("Divisione per zero non consentita");
        }
        return x / y;
    }
    
    static double modulo(double x, double y) {
        if (y == 0) {
            throw new IllegalArgumentException("Modulo per zero non consentito");
        }
        return x % y;
    }
    
    // Operazioni avanzate
    static double power(double base, double exponent) {
        return Math.pow(base, exponent);
    }
    
    static double squareRoot(double x) {
        if (x < 0) {
            throw new IllegalArgumentException("Radice quadrata di numero negativo non consentita");
        }
        return Math.sqrt(x);
    }
    
    static double absoluteValue(double x) {
        return Math.abs(x);
    }
    
    static double logarithm(double x) {
        if (x <= 0) {
            throw new IllegalArgumentException("Logaritmo richiede numero positivo");
        }
        return Math.log10(x);
    }
    
    static double naturalLogarithm(double x) {
        if (x <= 0) {
            throw new IllegalArgumentException("Logaritmo naturale richiede numero positivo");
        }
        return Math.log(x);
    }
    
    // Operazioni trigonometriche
    static double sine(double x) {
        return Math.sin(x);
    }
    
    static double cosine(double x) {
        return Math.cos(x);
    }
    
    static double tangent(double x) {
        return Math.tan(x);
    }
}
