import java.util.logging.Logger;
import java.util.logging.Level;

public class Calculator{
    private static final Logger logger = Logger.getLogger(Calculator.class.getName());
    
    private Calculator() {}
    
    static int sum(int x, int y){
        logger.log(Level.INFO, "Performing sum: " + x + " + " + y);
        int result = x + y;
        logger.log(Level.INFO, "Sum result: " + result);
        return result;
    }
    
    static int prod(int x, int y){
        logger.log(Level.INFO, "Performing product: " + x + " * " + y);
        int result = x * y;
        logger.log(Level.INFO, "Product result: " + result);
        return result;
    }
    
    static int divide(int x, int y) {
        logger.log(Level.INFO, "Performing division: " + x + " / " + y);
        if (y == 0) {
            logger.log(Level.SEVERE, "Division by zero attempted!");
            throw new IllegalArgumentException("Cannot divide by zero");
        }
        int result = x / y;
        logger.log(Level.INFO, "Division result: " + result);
        return result;
    }
    
    static double logarithm(double x) {
        logger.log(Level.INFO, "Performing logarithm (base 10): log(" + x + ")");
        if (x <= 0) {
            logger.log(Level.SEVERE, "Logarithm of non-positive number attempted!");
            throw new IllegalArgumentException("Logarithm requires positive number");
        }
        double result = Math.log10(x);
        logger.log(Level.INFO, "Logarithm result: " + result);
        return result;
    }
    
    static double naturalLogarithm(double x) {
        logger.log(Level.INFO, "Performing natural logarithm: ln(" + x + ")");
        if (x <= 0) {
            logger.log(Level.SEVERE, "Natural logarithm of non-positive number attempted!");
            throw new IllegalArgumentException("Natural logarithm requires positive number");
        }
        double result = Math.log(x);
        logger.log(Level.INFO, "Natural logarithm result: " + result);
        return result;
    }
}
